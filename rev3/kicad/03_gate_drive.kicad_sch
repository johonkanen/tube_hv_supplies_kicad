	(text "03 Gate drive: one UCC21520 per bridge (replaces v2's four Si8271): hardware dead time and shoot-through block, DIS from the HV_PERMIT / HV_ENABLE / fault logic (sheet 05), 10k gate-emitter resistors so the IGBTs stay off with the drivers unpowered, PWM inputs pulled down."
		(exclude_from_sim no)
		(at 30.48 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8920f964-ef00-5016-8805-e84c8cd178dd")
	)
